# Instascope Environmental Variables
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun.

# --- APP Settings ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://instascope.com.tr

# --- Cloudflare Tunnel Configuration ---
# Cloudflare Zero Trust Dashboard'dan alınan tünel token'ı
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# --- Firebase Configuration ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# --- Google Analytics ---
NEXT_PUBLIC_GA_ID=your_ga_measurement_id_here

# --- Ads ---
NEXT_PUBLIC_SHOW_ADS=false